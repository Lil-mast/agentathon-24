# GCP project + region
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us

# Document AI
DOCAI_PROCESSOR_ID=your-docai-processor-id
DOCAI_LOCATION=us

# BigQuery
BQ_DATASET=county_budget
BQ_LOCATION=US

# Vertex AI embeddings
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Optional GCS bucket for parsed-output cache; leave blank to fall back to PARSED_OUTPUT_DIR
GCS_BUCKET=
PARSED_OUTPUT_DIR=data/parsed

# Server
PORT=8080
FLASK_DEBUG=0
