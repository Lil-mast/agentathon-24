# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# GCP / Vertex AI (optional for local dev — mock LLM used without creds)
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_MODEL=gemini-1.5-pro-002
USE_MOCK_LLM=auto

# Local dev search (Person 2 fallback until Person 1 BigQuery is ready)
LOCAL_CHUNKS_PATH=data/chunks.json
BUDGET_PDF_PATH=../2024-25-FY-Budget-Submission-PBB-DRAFT Nairobi.pdf
INTERNAL_SEARCH_MODE=local

# Agent session memory
AGENT_MAX_TURNS=10
AGENT_CONTEXT_TURNS=6

# Ask endpoint
ASK_TIMEOUT_SECONDS=30
SEARCH_TOP_K=8
