# --- GCP project + locations (shared) ---
# Person 1 reads GCP_PROJECT_ID; Person 2 code reads GOOGLE_CLOUD_PROJECT.
# Setting GCP_PROJECT_ID is sufficient; Config aliases it for Person 2.
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us
VERTEX_LOCATION=us-central1

# --- BigQuery (Person 1 ingest + Person 2 subscribers/amendments) ---
BQ_DATASET=county_budget
BQ_LOCATION=US

# --- Document AI (Person 1 ingest fallback if pypdf parse is poor) ---
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=us

# --- Vertex AI embeddings (Person 1) ---
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# --- LLM (Person 3 agent / Q&A) ---
VERTEX_MODEL=gemini-1.5-pro-002
GEMINI_MODEL=gemini-1.5-pro
USE_MOCK_LLM=auto

# --- Vertex AI Agent Builder / Reasoning Engine (Person 3) ---
AGENT_ENGINE_ID=
USE_MOCK_AGENT=auto

# --- Storage ---
GCS_BUCKET=
PARSED_OUTPUT_DIR=data/parsed

# --- Internal auth (Person 2 cron endpoints) ---
APP_INTERNAL_TOKEN=replace-with-strong-random-token

# --- Internal search routing (Person 3 -> Person 1) ---
INTERNAL_SEARCH_MODE=local
INTERNAL_SEARCH_URL=http://127.0.0.1:8080/internal/search

# --- Africa's Talking SMS (Person 2) ---
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Gazette monitor (Person 2) ---
GAZETTE_SOURCE_URL=
ASK_API_URL=http://localhost:8080/api/ask
ENABLE_DEV_SCHEDULER=false

# --- Local fallback search (Person 3) ---
LOCAL_CHUNKS_PATH=data/chunks.json
BUDGET_PDF_PATH=../2024-25-FY-Budget-Submission-PBB-DRAFT Nairobi.pdf

# --- Agent runtime ---
AGENT_MAX_TURNS=10
AGENT_CONTEXT_TURNS=6
ASK_TIMEOUT_SECONDS=30
SEARCH_TOP_K=8

# --- Server ---
PORT=8080
FLASK_DEBUG=0
